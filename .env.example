# =============================================================================
# ProdKB — Environment Variables
# =============================================================================
# Copy this file to .env and replace placeholder values before deployment.
# All variables below are referenced by docker-compose.yml via ${VAR:-default}.
# =============================================================================

# --- Database ---
POSTGRES_USER=prodkb
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=prodkb

# --- Backend ---
JWT_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_STRING_MIN_32_CHARS
NODE_ENV=production
LOG_LEVEL=info
FRONTEND_URL=http://localhost:8080

# --- SMTP (optional — leave blank to disable email notifications) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
