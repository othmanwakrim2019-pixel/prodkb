{
  "name": "prodkb-backend",
  "version": "1.0.0",
  "description": "ProdKB — Incident Management Backend",
  "main": "dist/src/server.js",
  "scripts": {
    "── Development ──": "",
    "dev": "tsx watch src/server.ts",
    "build": "npx prisma generate && tsc && cp src/config/openapi.yaml dist/src/config/openapi.yaml 2>/dev/null || true",
    "start": "chmod +x ./start.sh && ./start.sh",
    "── Testing ──": "",
    "test": "jest --forceExit --coverage",
    "test:changed": "jest --onlyChanged",
    "test:watch": "jest --watch",
    "── Database ──": "",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:validate": "prisma validate",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seeds/index.ts",
    "seed:demo": "tsx prisma/seeds/index.ts --demo",
    "── Workers ──": "",
    "worker:sla": "tsx src/workers/sla.worker.ts",
    "worker:webhook": "tsx src/workers/webhook.worker.ts",
    "worker:digest": "tsx src/workers/digest.worker.ts",
    "worker:cleanup": "tsx src/workers/cleanup.worker.ts",
    "── Code Quality ──": "",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "prisma": {
    "seed": "tsx prisma/seeds/index.ts"
  },
  "keywords": [
    "incident-management",
    "prodkb",
    "operations"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.4.1",
    "@aws-sdk/client-s3": "^3.994.0",
    "@aws-sdk/s3-request-presigner": "^3.994.0",
    "@bull-board/api": "^6.19.0",
    "@bull-board/express": "^6.19.0",
    "@prisma/client": "^6.19.0",
    "@sentry/node": "^10.39.0",
    "@sentry/profiling-node": "^10.39.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.13.5",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.69.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "file-type": "^16.5.4",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.3",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.0",
    "papaparse": "^5.5.3",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^4.3.1",
    "sanitize-html": "^2.17.1",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "yamljs": "^0.3.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^7.0.9",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.16.0",
    "@types/sanitize-html": "^2.16.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/winston": "^2.4.4",
    "@types/yamljs": "^0.2.34",
    "jest": "^30.2.0",
    "pg": "^8.18.0",
    "prisma": "^6.19.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}