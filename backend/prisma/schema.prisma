// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// PostgreSQL configuration (Docker/Production)
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String  @id @default(uuid())
  name     String
  email    String  @unique
  password String
  isActive Boolean @default(true)

  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdIncidents  Incident[]    @relation("CreatedIncidents")
  resolvedIncidents Incident[]    @relation("ResolvedIncidents")
  updatedIncidents  Incident[]    @relation("UpdatedIncidents")
  createdProcedures Procedure[]   @relation("CreatedProcedures")
  updatedProcedures Procedure[]   @relation("UpdatedProcedures")
  updatedTeams      Team[]        @relation("UpdatedTeams")
  updatedSystems    System[]      @relation("UpdatedSystems")
  updatedJobs       Job[]         @relation("UpdatedJobs")
  updatedSLAs       SLA[]         @relation("UpdatedSLAs")
  updatedRoles      Role[]        @relation("UpdatedRoles")
  createdLogs       IncidentLog[] @relation("CreatedLogs")
  auditLogs         AuditLog[]
  teamMemberships   TeamMember[]

  @@index([roleId])
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  users       User[]
  permissions Permission[]
  updatedById String?
  updatedBy   User?        @relation("UpdatedRoles", fields: [updatedById], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  description String?
  roles       Role[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailTemplate {
  id        String   @id @default(uuid())
  name      String   @unique // e.g., "INCIDENT_CREATED", "INCIDENT_UPDATED"
  subject   String
  body      String   @db.Text
  variables String? // Comma-separated list of available variables
  enabled   Boolean  @default(true)
  cc        String? // Comma-separated list of CC emails
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Team {
  id                String   @id @default(uuid())
  name              String   @unique
  description       String?
  emailDistribution String
  isActive          Boolean  @default(true)
  sendEmail         Boolean  @default(true)
  updatedById       String?
  updatedBy         User?    @relation("UpdatedTeams", fields: [updatedById], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  members   TeamMember[]
  jobs      Job[]
  incidents Incident[]

  @@index([name])
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  createdAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model SLA {
  id                     String   @id @default(uuid())
  name                   String   @unique
  description            String?
  severity               String
  acknowledgeTimeMinutes Int
  resolveTimeMinutes     Int
  isActive               Boolean  @default(true)
  updatedById            String?
  updatedBy              User?    @relation("UpdatedSLAs", fields: [updatedById], references: [id])
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  incidents Incident[]

  @@index([severity])
}

model System {
  id          String      @id @default(uuid())
  name        String      @unique
  description String?
  jobs        Job[]
  incidents   Incident[]
  procedures  Procedure[]
  updatedById String?
  updatedBy   User?       @relation("UpdatedSystems", fields: [updatedById], references: [id])

  @@index([name])
}

model Job {
  id          String      @id @default(uuid())
  name        String
  code        String      @unique
  systemId    String
  system      System      @relation(fields: [systemId], references: [id])
  teamId      String?
  team        Team?       @relation(fields: [teamId], references: [id], onDelete: SetNull)
  incidents   Incident[]
  procedures  Procedure[]
  updatedById String?
  updatedBy   User?       @relation("UpdatedJobs", fields: [updatedById], references: [id])

  @@index([systemId])
  @@index([teamId])
  @@index([code])
}

model Incident {
  id              String    @id @default(uuid())
  title           String
  description     String
  environment     String
  severity        String
  status          String
  impact          String?
  detectionSource String?
  startDatetime   DateTime?
  endDatetime     DateTime?

  systemId String
  system   System @relation(fields: [systemId], references: [id])

  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id])

  createdById String
  createdBy   User   @relation("CreatedIncidents", fields: [createdById], references: [id])

  resolvedById String?
  resolvedBy   User?   @relation("ResolvedIncidents", fields: [resolvedById], references: [id])

  updatedById String?
  updatedBy   User?   @relation("UpdatedIncidents", fields: [updatedById], references: [id])

  assignedTeamId String?
  assignedTeam   Team?   @relation(fields: [assignedTeamId], references: [id], onDelete: SetNull)

  slaId String?
  sla   SLA?    @relation(fields: [slaId], references: [id], onDelete: SetNull)

  acknowledgedAt    DateTime?
  resolvedAt        DateTime?
  timeToAcknowledge Int?
  timeToResolve     Int?

  linkedProcedureId String?
  linkedProcedure   Procedure? @relation(fields: [linkedProcedureId], references: [id])

  logs IncidentLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedTeamId])
  @@index([slaId])
  @@index([status])
  @@index([severity])
  @@index([systemId])
  @@index([createdAt])
  @@index([environment])
  @@index([status, createdAt]) // Optimized for dashboard
}

model IncidentLog {
  id           String   @id @default(uuid())
  incidentId   String
  incident     Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  logType      String
  errorCode    String?
  errorMessage String?
  rawLog       String?
  metadata     String?

  filePath String?
  fileName String?
  fileSize Int?
  mimeType String?

  createdById String?
  createdBy   User?   @relation("CreatedLogs", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([incidentId])
  @@index([logType])
}

model Procedure {
  id              String  @id @default(uuid())
  title           String
  description     String
  rootCause       String?
  resolutionSteps String
  workaround      String?
  commands        String?
  errorCode       String?
  tags            String?

  systemId String
  system   System @relation(fields: [systemId], references: [id])

  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id])

  createdById String
  createdBy   User   @relation("CreatedProcedures", fields: [createdById], references: [id])

  updatedById String?
  updatedBy   User?   @relation("UpdatedProcedures", fields: [updatedById], references: [id])

  incidents Incident[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([systemId])
  @@index([errorCode])
  @@index([title])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  actionType String
  entityType String
  entityId   String
  details    String?
  ipAddress  String?
  userAgent  String?
  result     String   @default("SUCCESS")
  timestamp  DateTime @default(now())

  @@index([userId])
  @@index([actionType])
  @@index([entityType])
  @@index([timestamp])
}

enum PlanningPeriod {
  monthly
  quarterly
  annual
}

enum PlanningStatus {
  pending
  running
  done
}

model PlanningJob {
  id            String         @id @default(uuid())
  name          String
  application   String
  scheduledTime DateTime
  period        PlanningPeriod
  dependencies  Json           @default("[]") // Array of PlanningJob IDs
  status        PlanningStatus @default(pending)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([period])
  @@index([status])
  @@index([period, status])
}
