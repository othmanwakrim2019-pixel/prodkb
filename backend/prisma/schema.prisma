// ═══════════════════════════════════════════════════════════════
// ProdKB — Prisma Schema
// ═══════════════════════════════════════════════════════════════
// Models are grouped by domain. Enums are declared first.
// Field order: id → required fields → optional fields → timestamps → relations
// Every foreign key has an @@index unless it has @@unique.
// ═══════════════════════════════════════════════════════════════

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════════

/// Planning period granularity
enum PlanningPeriod {
  monthly
  quarterly
  annual
}

/// Task type for planning jobs
enum TaskType {
  BATCH         // Automated server job (GP, PACK, ICNE, etc.)
  MANUAL_ACTION // Human task (close branches, open accounting period, etc.)
}

/// Status of an individual planning job
enum PlanningStatus {
  pending
  running  // BATCH: job was launched and is executing
  done
  failed   // Job failed — can trigger an Incident
  blocked  // Waiting on a dependency that is not yet done
}

/// Status of a planning instance (monthly/quarterly cycle)
enum InstanceStatus {
  active
  archived
}

// ═══════════════════════════════════════════════════════════════
// IDENTITY & ACCESS
// ═══════════════════════════════════════════════════════════════

/// Application user — authenticates via email/password, assigned one Role
model User {
  id       String  @id @default(uuid())
  name     String
  email    String  @unique
  password String                        // bcrypt hash
  isActive Boolean @default(true)

  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Relations ──
  createdIncidents      Incident[]          @relation("CreatedIncidents")
  resolvedIncidents     Incident[]          @relation("ResolvedIncidents")
  updatedIncidents      Incident[]          @relation("UpdatedIncidents")
  createdProcedures     Procedure[]         @relation("CreatedProcedures")
  updatedProcedures     Procedure[]         @relation("UpdatedProcedures")
  updatedTeams          Team[]              @relation("UpdatedTeams")
  updatedSystems        System[]            @relation("UpdatedSystems")
  updatedJobs           Job[]               @relation("UpdatedJobs")
  updatedSLAs           SLA[]               @relation("UpdatedSLAs")
  updatedRoles          Role[]              @relation("UpdatedRoles")
  createdLogs           IncidentLog[]       @relation("CreatedLogs")
  auditLogs             AuditLog[]
  teamMemberships       TeamMember[]
  createdInstances      PlanningInstance[]   @relation("CreatedInstances")
  completedPlanningJobs PlanningJob[]       @relation("CompletedPlanningJobs")
  launchedPlanningJobs  PlanningJob[]       @relation("LaunchedPlanningJobs")
  refreshTokens         RefreshToken[]
  notifications         Notification[]
  postMortems           PostMortem[]
  maintenanceCreated    MaintenanceWindow[] @relation("MaintenanceCreatedBy")
  warRoomMessages       WarRoomMessage[]    @relation("WarRoomMessages")
  // Gestion Équipe relations
  astreintes            Astreinte[]         @relation("AstreinteUser")
  createdAstreintes     Astreinte[]         @relation("AstreinteCreatedBy")
  createdDailyPlans     DailyPlan[]         @relation("PlanCreatedBy")
  assignedTasks         OperationalTask[]   @relation("AssignedOpTasks")
  createdTasks          OperationalTask[]   @relation("CreatedOpTasks")

  @@index([roleId])
}

/// Named role (ADMIN, EXPERT, OPERATOR, VIEWER) with many-to-many permissions
model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?

  // Controls which incidents members of this role can see.
  // ALL = see every incident; TEAM_ONLY = see only incidents assigned to their team
  incidentScope IncidentScope @default(ALL)

  updatedById String?
  updatedBy   User?    @relation("UpdatedRoles", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users       User[]
  permissions Permission[]

  @@index([updatedById])
}

enum IncidentScope {
  ALL
  TEAM_ONLY
}

/// Granular permission code (INCIDENT_CREATE, USER_MANAGE, etc.) linked to Roles
model Permission {
  id          String   @id @default(uuid())
  code        String   @unique               // e.g. INCIDENT_CREATE, AUDIT_VIEW
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Relations ──
  roles Role[]
}

/// JWT refresh token for token rotation — revoked on logout or expiry
model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?                        // set when explicitly revoked

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// ═══════════════════════════════════════════════════════════════
// ORGANIZATION
// ═══════════════════════════════════════════════════════════════

/// Operations team — incidents can be assigned to teams, teams receive email notifications
model Team {
  id                String   @id @default(uuid())
  name              String   @unique
  description       String?
  emailDistribution String                   // distribution list email address
  isActive          Boolean  @default(true)
  sendEmail         Boolean  @default(true)  // whether to send email on incident assignment

  updatedById String?
  updatedBy   User?    @relation("UpdatedTeams", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Relations ──
  members         TeamMember[]
  jobs            Job[]
  incidents       Incident[]
  escalationRules EscalationRule[]      @relation("EscalationTeam")
  autoAssignRules AutoAssignmentRule[]  @relation("AutoAssignTeam")
  // Gestion Équipe relations
  astreintes      Astreinte[]
  dailyPlans      DailyPlan[]

  @@index([name])
  @@index([updatedById])
}

/// Join table: User ↔ Team with a role (LEAD or MEMBER)
model TeamMember {
  id     String @id @default(uuid())
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   String                              // LEAD | MEMBER

  createdAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════
// GESTION ÉQUIPE — Astreinte, Daily Plans, Operational Tasks
// ═══════════════════════════════════════════════════════════════

/// Weekly on-call rotation — one person per week is responsible for any production incident
model Astreinte {
  id          String   @id @default(uuid())
  weekNumber  Int                             // ISO week number (1-52)
  year        Int
  startDate   DateTime                        // Monday 00:00
  endDate     DateTime                        // Sunday 23:59
  phone       String?                         // direct contact for this week
  notes       String?                         // any special instructions

  teamId      String
  team        Team     @relation(fields: [teamId], references: [id])
  userId      String                          // who is on astreinte
  user        User     @relation("AstreinteUser", fields: [userId], references: [id])

  createdById String
  createdBy   User     @relation("AstreinteCreatedBy", fields: [createdById], references: [id])

  // ── Relations ──
  incidents      Incident[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([teamId, weekNumber, year])        // one person per team per week
  @@index([teamId])
  @@index([userId])
  @@index([startDate, endDate])
  @@index([createdById])
}

/// A single day's operational plan for a team — groups all tasks for that day
model DailyPlan {
  id        String    @id @default(uuid())
  date      DateTime                          // the day this plan covers (midnight UTC)
  label     String?                           // e.g. "Journée lundi", "Weekend 26-27 Avr"
  isWeekend Boolean   @default(false)

  teamId    String
  team      Team      @relation(fields: [teamId], references: [id])

  createdById String
  createdBy   User    @relation("PlanCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tasks     OperationalTask[]

  @@unique([teamId, date])                    // one plan per team per day
  @@index([teamId])
  @@index([date])
  @@index([createdById])
}

/// One operational task assigned to one person within a DailyPlan
model OperationalTask {
  id          String                  @id @default(uuid())
  planId      String
  plan        DailyPlan               @relation(fields: [planId], references: [id], onDelete: Cascade)

  title       String                          // short label on the board
  description String?                         // detailed instructions
  taskType    OperationalTaskType     @default(CUSTOM)
  priority    OperationalTaskPriority @default(NORMAL)
  status      OperationalTaskStatus   @default(TODO)

  startTime   DateTime?                       // scheduled start within the day
  endTime     DateTime?                       // scheduled end

  // What server / chain this task concerns
  systemId    String?
  system      System?                 @relation(fields: [systemId], references: [id])
  chainLabel  String?                         // free-text: "Chaîne compta", "Chaîne virements"

  // Who is responsible
  assignedToId String
  assignedTo   User                   @relation("AssignedOpTasks", fields: [assignedToId], references: [id])

  // Completion tracking
  note        String?                         // operator note on completion or blocker reason
  startedAt   DateTime?
  completedAt DateTime?

  createdById String
  createdBy   User                    @relation("CreatedOpTasks", fields: [createdById], references: [id])

  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([planId])
  @@index([assignedToId])
  @@index([systemId])
  @@index([status])
  @@index([taskType])
  @@index([priority])
  @@index([createdById])
}

/// Task type — what kind of operational duty this is
enum OperationalTaskType {
  MEP               // Mise En Production (deployment)
  SUPERVISION       // Supervise a system or chain
  TABLEAU_BORD      // Create / maintain daily dashboard
  REPRISE_INCIDENT  // Take over ongoing incident recovery
  CONTROLE_CHAINE   // Verify a processing chain
  RAPPORT           // Write a report
  CUSTOM            // Free-text task
}

/// Status of an operational task — operator updates this
enum OperationalTaskStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED         // Triggers notification to manager
}

/// Priority of an operational task
enum OperationalTaskPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

// ═══════════════════════════════════════════════════════════════
// INFRASTRUCTURE — Systems, Jobs, SLAs
// ═══════════════════════════════════════════════════════════════

/// IT system or application being monitored (e.g. "Core Banking", "API Gateway")
model System {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  updatedById String?
  updatedBy   User?   @relation("UpdatedSystems", fields: [updatedById], references: [id])

  // ── Relations ──
  jobs               Job[]
  incidents          Incident[]
  procedures         Procedure[]
  planningJobs       PlanningJob[]
  escalationRules    EscalationRule[]
  autoAssignRules    AutoAssignmentRule[]
  healthSnapshots    SystemHealthSnapshot[]
  maintenanceWindows MaintenanceWindow[]
  operationalTasks   OperationalTask[]

  @@index([name])
  @@index([updatedById])
}

/// Batch job or scheduled process that belongs to a System
model Job {
  id       String @id @default(uuid())
  name     String
  code     String @unique                   // unique job code (e.g. GP_001)
  systemId String
  system   System @relation(fields: [systemId], references: [id])
  teamId   String?
  team     Team?  @relation(fields: [teamId], references: [id], onDelete: SetNull)

  updatedById String?
  updatedBy   User?  @relation("UpdatedJobs", fields: [updatedById], references: [id])

  // ── Relations ──
  incidents    Incident[]
  procedures   Procedure[]
  planningJobs PlanningJob[]

  @@index([systemId])
  @@index([teamId])
  @@index([code])
  @@index([updatedById])
}

/// Service Level Agreement — defines response/resolve time targets per severity
model SLA {
  id                     String   @id @default(uuid())
  name                   String   @unique
  description            String?
  severity               String                  // Critical, High, Medium, Low
  acknowledgeTimeMinutes Int                     // max minutes to acknowledge
  resolveTimeMinutes     Int                     // max minutes to resolve
  isActive               Boolean  @default(true)

  updatedById String?
  updatedBy   User?    @relation("UpdatedSLAs", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Relations ──
  incidents Incident[]

  @@index([severity])
  @@index([updatedById])
}

// ═══════════════════════════════════════════════════════════════
// INCIDENTS — Core domain
// ═══════════════════════════════════════════════════════════════

/// Production incident — the central entity of ProdKB
model Incident {
  id              String    @id @default(uuid())
  title           String
  description     String
  environment     String                       // PROD, PREPROD, RECETTE
  severity        String                       // Critical, High, Medium, Low
  status          String                       // Open, Acknowledged, In Progress, Resolved, Closed
  impact          String?
  detectionSource String?                      // monitoring, user_report, etc.
  startDatetime   DateTime?
  endDatetime     DateTime?

  // Foreign keys
  systemId       String
  system         System    @relation(fields: [systemId], references: [id])
  jobId          String?
  job            Job?      @relation(fields: [jobId], references: [id])
  createdById    String
  createdBy      User      @relation("CreatedIncidents", fields: [createdById], references: [id])
  resolvedById   String?
  resolvedBy     User?     @relation("ResolvedIncidents", fields: [resolvedById], references: [id])
  updatedById    String?
  updatedBy      User?     @relation("UpdatedIncidents", fields: [updatedById], references: [id])
  assignedTeamId String?
  assignedTeam   Team?     @relation(fields: [assignedTeamId], references: [id], onDelete: SetNull)
  slaId          String?
  sla            SLA?      @relation(fields: [slaId], references: [id], onDelete: SetNull)

  // SLA tracking
  acknowledgedAt    DateTime?
  resolvedAt        DateTime?
  timeToAcknowledge Int?                       // computed minutes to acknowledge
  timeToResolve     Int?                       // computed minutes to resolve

  // Optimistic locking + SLA enforcement
  version             Int       @default(1)
  escalationLevel     Int       @default(0)
  slaBreached         Boolean   @default(false)
  slaBreachNotifiedAt DateTime?

  // Linked resolution procedure
  linkedProcedureId String?
  linkedProcedure   Procedure? @relation(fields: [linkedProcedureId], references: [id])

  // Astreinte auto-link (Phase 2 integration)
  astreinteId    String?
  astreinte      Astreinte? @relation(fields: [astreinteId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Relations ──
  logs            IncidentLog[]
  postMortem      PostMortem?
  warRoomMessages WarRoomMessage[]

  @@index([systemId])
  @@index([jobId])
  @@index([createdById])
  @@index([resolvedById])
  @@index([updatedById])
  @@index([assignedTeamId])
  @@index([slaId])
  @@index([status])
  @@index([severity])
  @@index([createdAt])
  @@index([environment])
  @@index([linkedProcedureId])
  @@index([status, createdAt])        // dashboard: recent incidents by status
  @@index([slaBreached, status])      // SLA enforcement queries
}

/// Log entry attached to an incident (raw log, screenshot, file, note)
model IncidentLog {
  id           String   @id @default(uuid())
  incidentId   String
  incident     Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  logType      String                         // raw_log, screenshot, file, error_message, note
  errorCode    String?
  errorMessage String?
  rawLog       String?
  metadata     String?                        // JSON blob for extra context

  // File attachment fields
  filePath String?
  fileName String?
  fileSize Int?
  mimeType String?

  createdById String?
  createdBy   User?    @relation("CreatedLogs", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([incidentId])
  @@index([logType])
  @@index([createdById])
}

/// Post-mortem / Root Cause Analysis — one per incident
model PostMortem {
  id                String   @id @default(uuid())
  incidentId        String   @unique
  incident          Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  summary           String   @db.Text
  rootCause         String   @db.Text
  timeline          String   @db.Text
  impact            String   @db.Text
  lessonsLearned    String   @db.Text
  preventiveActions String   @db.Text
  status            String   @default("DRAFT")  // DRAFT | PUBLISHED

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([incidentId])
  @@index([status])
  @@index([createdById])
}

/// Real-time chat message in an incident War Room
model WarRoomMessage {
  id         String   @id @default(uuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation("WarRoomMessages", fields: [userId], references: [id])
  content    String
  type       String   @default("message")     // message | system_event

  createdAt DateTime @default(now())

  @@index([incidentId, createdAt])
  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════
// KNOWLEDGE BASE — Procedures
// ═══════════════════════════════════════════════════════════════

/// Resolution procedure / runbook — reusable fix documentation
model Procedure {
  id              String  @id @default(uuid())
  title           String
  description     String
  resolutionSteps String
  rootCause       String?
  workaround      String?
  commands        String?                      // CLI commands to run
  errorCode       String?                      // error code this procedure fixes
  tags            String?                      // comma-separated tags

  systemId String
  system   System @relation(fields: [systemId], references: [id])
  jobId    String?
  job      Job?   @relation(fields: [jobId], references: [id])

  createdById String
  createdBy   User   @relation("CreatedProcedures", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?  @relation("UpdatedProcedures", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Relations ──
  incidents Incident[]

  @@index([systemId])
  @@index([jobId])
  @@index([errorCode])
  @@index([title])
  @@index([createdById])
  @@index([updatedById])
}

// ═══════════════════════════════════════════════════════════════
// PLANNING
// ═══════════════════════════════════════════════════════════════

/// Planning cycle instance (e.g. "March 2026 Monthly Planning")
model PlanningInstance {
  id          String         @id @default(uuid())
  name        String
  description String?
  period      PlanningPeriod
  startDate   DateTime
  endDate     DateTime
  status      InstanceStatus @default(active)

  createdById String
  createdBy   User @relation("CreatedInstances", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Relations ──
  jobs PlanningJob[]

  @@index([period, status])
  @@index([createdById])
}

/// Individual task within a planning instance — either a BATCH job or MANUAL_ACTION
model PlanningJob {
  id             String          @id @default(uuid())
  instanceId     String
  instance       PlanningInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  systemId       String?
  system         System?         @relation(fields: [systemId], references: [id])
  jobId          String?
  job            Job?            @relation(fields: [jobId], references: [id])
  customTaskName String?                       // free-text name for MANUAL_ACTION
  scheduledTime  DateTime
  dependencies   Json            @default("[]") // array of PlanningJob IDs
  status         PlanningStatus  @default(pending)
  taskType       TaskType        @default(BATCH)
  supportContact String?                       // e.g. "Radouane", "Réseaux et télécoms"
  notes          String?                       // operator confirmation note

  // Visual layout (canvas position)
  positionX Float?
  positionY Float?

  // BATCH tracking
  launchedAt   DateTime?
  launchedById String?
  launchedBy   User?    @relation("LaunchedPlanningJobs", fields: [launchedById], references: [id])

  // Completion tracking
  completedAt   DateTime?
  completedById String?
  completedBy   User?    @relation("CompletedPlanningJobs", fields: [completedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([instanceId])
  @@index([systemId])
  @@index([jobId])
  @@index([status])
  @@index([taskType])
  @@index([launchedById])
  @@index([completedById])
}

// ═══════════════════════════════════════════════════════════════
// AUTOMATION — Escalation, Auto-Assignment, Webhooks
// ═══════════════════════════════════════════════════════════════

/// Escalation rule — auto-escalates an incident to a team after N minutes of SLA breach
model EscalationRule {
  id           String   @id @default(uuid())
  name         String
  systemId     String?
  system       System?  @relation(fields: [systemId], references: [id], onDelete: SetNull)
  severity     String?                        // null = applies to all severities
  level        Int      @default(1)           // escalation tier (1, 2, 3...)
  teamId       String
  team         Team     @relation("EscalationTeam", fields: [teamId], references: [id])
  delayMinutes Int                            // minutes after breach before trigger
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([systemId, severity, level])
  @@index([systemId, severity])
  @@index([teamId])
}

/// Auto-assignment rule — automatically assigns new incidents to a team
model AutoAssignmentRule {
  id       String   @id @default(uuid())
  name     String
  systemId String?
  system   System?  @relation(fields: [systemId], references: [id], onDelete: SetNull)
  severity String?                            // null = wildcard (all severities)
  teamId   String
  team     Team     @relation("AutoAssignTeam", fields: [teamId], references: [id])
  priority Int      @default(0)               // higher number wins when multiple match
  isActive Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([systemId, severity])
  @@index([teamId])
}

/// Webhook endpoint — receives HTTP callbacks on incident events
model Webhook {
  id       String  @id @default(uuid())
  name     String
  url      String
  secret   String                             // HMAC-SHA256 signing secret
  events   String                             // comma-separated: incident.created,incident.resolved,...
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Relations ──
  deliveries WebhookDelivery[]
}

/// Individual webhook delivery attempt with status tracking
model WebhookDelivery {
  id           String    @id @default(uuid())
  webhookId    String
  webhook      Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event        String
  payload      String    @db.Text
  statusCode   Int?
  response     String?   @db.Text
  deliveredAt  DateTime?
  attemptCount Int       @default(0)
  success      Boolean   @default(false)
  error        String?

  createdAt DateTime @default(now())

  @@index([webhookId])
  @@index([event])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════
// NOTIFICATIONS & AUDIT
// ═══════════════════════════════════════════════════════════════

/// In-app notification bell — unread/read per user
model Notification {
  id         String  @id @default(uuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String                            // incident_created, status_changed, note_added, file_uploaded
  title      String
  message    String
  incidentId String?                           // optional link to incident
  isRead     Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
  @@index([incidentId])
}

/// Immutable audit trail — every significant user action is logged
model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  actionType String                           // LOGIN, CREATE, UPDATE, DELETE, EXPORT, VIEW
  entityType String                           // USER, INCIDENT, PROCEDURE, TEAM, SYSTEM, etc.
  entityId   String
  details    String?                           // JSON with change details
  ipAddress  String?
  userAgent  String?
  result     String   @default("SUCCESS")

  timestamp DateTime @default(now())

  @@index([userId])
  @@index([actionType])
  @@index([entityType])
  @@index([entityId])
  @@index([timestamp])
}

// ═══════════════════════════════════════════════════════════════
// OPERATIONS — Maintenance, Health Monitoring
// ═══════════════════════════════════════════════════════════════

/// Scheduled maintenance window for a system
model MaintenanceWindow {
  id          String   @id @default(uuid())
  systemId    String
  system      System   @relation(fields: [systemId], references: [id], onDelete: Cascade)
  title       String
  description String?
  scheduledAt DateTime
  endsAt      DateTime
  status      String   @default("scheduled")  // scheduled | active | completed | cancelled

  createdById String
  createdBy   User     @relation("MaintenanceCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([systemId, scheduledAt])
  @@index([status])
  @@index([scheduledAt, endsAt])
  @@index([createdById])
}

/// Periodic health score snapshot for a system — computed by analytics worker
model SystemHealthSnapshot {
  id               String   @id @default(uuid())
  systemId         String
  system           System   @relation(fields: [systemId], references: [id], onDelete: Cascade)
  score            Int                         // 0-100 composite health score
  incidentCount30d Int      @default(0)
  avgMttrMinutes   Float    @default(0)        // Mean Time To Resolve
  slaBreachRate    Float    @default(0)        // 0.0 - 1.0
  resolutionRate   Float    @default(0)        // 0.0 - 1.0
  openIncidents    Int      @default(0)

  computedAt DateTime @default(now())

  @@index([systemId, computedAt])
  @@index([computedAt])
  @@index([score])
}

// ═══════════════════════════════════════════════════════════════
// CONFIGURATION
// ═══════════════════════════════════════════════════════════════

/// Key-value configuration store for runtime settings
model SystemConfig {
  id    String @id @default(uuid())
  key   String @unique
  value String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Customizable email template for notifications
model EmailTemplate {
  id        String  @id @default(uuid())
  name      String  @unique                   // e.g. INCIDENT_CREATED, INCIDENT_UPDATED
  subject   String
  body      String  @db.Text
  variables String?                            // comma-separated available variables
  enabled   Boolean @default(true)
  cc        String?                            // comma-separated CC emails

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
