// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// PostgreSQL configuration (Docker/Production)
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String  @id @default(uuid())
  name     String
  email    String  @unique
  password String
  isActive Boolean @default(true)

  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdIncidents  Incident[]    @relation("CreatedIncidents")
  resolvedIncidents Incident[]    @relation("ResolvedIncidents")
  updatedIncidents  Incident[]    @relation("UpdatedIncidents")
  createdProcedures Procedure[]   @relation("CreatedProcedures")
  updatedProcedures Procedure[]   @relation("UpdatedProcedures")
  updatedTeams      Team[]        @relation("UpdatedTeams")
  updatedSystems    System[]      @relation("UpdatedSystems")
  updatedJobs       Job[]         @relation("UpdatedJobs")
  updatedSLAs       SLA[]         @relation("UpdatedSLAs")
  updatedRoles      Role[]        @relation("UpdatedRoles")
  createdLogs       IncidentLog[] @relation("CreatedLogs")
  auditLogs         AuditLog[]
  teamMemberships   TeamMember[]
  createdInstances  PlanningInstance[] @relation("CreatedInstances")
  completedPlanningJobs PlanningJob[] @relation("CompletedPlanningJobs")
  refreshTokens     RefreshToken[]
  notifications     Notification[]
  postMortems       PostMortem[]

  @@index([roleId])
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  users       User[]
  permissions Permission[]
  updatedById String?
  updatedBy   User?        @relation("UpdatedRoles", fields: [updatedById], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  description String?
  roles       Role[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailTemplate {
  id        String   @id @default(uuid())
  name      String   @unique // e.g., "INCIDENT_CREATED", "INCIDENT_UPDATED"
  subject   String
  body      String   @db.Text
  variables String? // Comma-separated list of available variables
  enabled   Boolean  @default(true)
  cc        String? // Comma-separated list of CC emails
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Team {
  id                String   @id @default(uuid())
  name              String   @unique
  description       String?
  emailDistribution String
  isActive          Boolean  @default(true)
  sendEmail         Boolean  @default(true)
  updatedById       String?
  updatedBy         User?    @relation("UpdatedTeams", fields: [updatedById], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  members   TeamMember[]
  jobs      Job[]
  incidents Incident[]
  escalationRules EscalationRule[] @relation("EscalationTeam")
  autoAssignRules AutoAssignmentRule[] @relation("AutoAssignTeam")

  @@index([name])
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  createdAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model SLA {
  id                     String   @id @default(uuid())
  name                   String   @unique
  description            String?
  severity               String
  acknowledgeTimeMinutes Int
  resolveTimeMinutes     Int
  isActive               Boolean  @default(true)
  updatedById            String?
  updatedBy              User?    @relation("UpdatedSLAs", fields: [updatedById], references: [id])
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  incidents Incident[]

  @@index([severity])
}

model System {
  id          String      @id @default(uuid())
  name        String      @unique
  description String?
  jobs        Job[]
  incidents   Incident[]
  planningJobs PlanningJob[]
  procedures  Procedure[]
  escalationRules EscalationRule[]
  autoAssignRules AutoAssignmentRule[]
  updatedById String?
  updatedBy   User?       @relation("UpdatedSystems", fields: [updatedById], references: [id])

  @@index([name])
}

model Job {
  id          String      @id @default(uuid())
  name        String
  code        String      @unique
  systemId    String
  system      System      @relation(fields: [systemId], references: [id])
  teamId      String?
  team        Team?       @relation(fields: [teamId], references: [id], onDelete: SetNull)
  incidents   Incident[]
  procedures  Procedure[]
  planningJobs PlanningJob[]
  updatedById String?
  updatedBy   User?       @relation("UpdatedJobs", fields: [updatedById], references: [id])

  @@index([systemId])
  @@index([teamId])
  @@index([code])
}

model Incident {
  id              String    @id @default(uuid())
  title           String
  description     String
  environment     String
  severity        String
  status          String
  impact          String?
  detectionSource String?
  startDatetime   DateTime?
  endDatetime     DateTime?

  systemId String
  system   System @relation(fields: [systemId], references: [id])

  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id])

  createdById String
  createdBy   User   @relation("CreatedIncidents", fields: [createdById], references: [id])

  resolvedById String?
  resolvedBy   User?   @relation("ResolvedIncidents", fields: [resolvedById], references: [id])

  updatedById String?
  updatedBy   User?   @relation("UpdatedIncidents", fields: [updatedById], references: [id])

  assignedTeamId String?
  assignedTeam   Team?   @relation(fields: [assignedTeamId], references: [id], onDelete: SetNull)

  slaId String?
  sla   SLA?    @relation(fields: [slaId], references: [id], onDelete: SetNull)

  acknowledgedAt    DateTime?
  resolvedAt        DateTime?
  timeToAcknowledge Int?
  timeToResolve     Int?

  // Phase 2: Optimistic locking + SLA enforcement
  version            Int       @default(1)
  escalationLevel    Int       @default(0)
  slaBreached        Boolean   @default(false)
  slaBreachNotifiedAt DateTime?

  linkedProcedureId String?
  linkedProcedure   Procedure? @relation(fields: [linkedProcedureId], references: [id])

  logs IncidentLog[]
  postMortem PostMortem?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedTeamId])
  @@index([slaId])
  @@index([status])
  @@index([severity])
  @@index([systemId])
  @@index([createdAt])
  @@index([environment])
  @@index([status, createdAt]) // Optimized for dashboard
  @@index([slaBreached, status]) // SLA enforcement queries
}

// ── Post-Mortem / Root Cause Analysis ──
model PostMortem {
  id                 String   @id @default(uuid())
  incidentId         String   @unique
  incident           Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  summary            String   @db.Text
  rootCause          String   @db.Text
  timeline           String   @db.Text
  impact             String   @db.Text
  lessonsLearned     String   @db.Text
  preventiveActions  String   @db.Text
  status             String   @default("DRAFT") // DRAFT | PUBLISHED
  createdById        String
  createdBy          User     @relation(fields: [createdById], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([incidentId])
  @@index([status])
}

model IncidentLog {
  id           String   @id @default(uuid())
  incidentId   String
  incident     Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  logType      String
  errorCode    String?
  errorMessage String?
  rawLog       String?
  metadata     String?

  filePath String?
  fileName String?
  fileSize Int?
  mimeType String?

  createdById String?
  createdBy   User?   @relation("CreatedLogs", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([incidentId])
  @@index([logType])
  @@index([createdById])
}

model Procedure {
  id              String  @id @default(uuid())
  title           String
  description     String
  rootCause       String?
  resolutionSteps String
  workaround      String?
  commands        String?
  errorCode       String?
  tags            String?

  systemId String
  system   System @relation(fields: [systemId], references: [id])

  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id])

  createdById String
  createdBy   User   @relation("CreatedProcedures", fields: [createdById], references: [id])

  updatedById String?
  updatedBy   User?   @relation("UpdatedProcedures", fields: [updatedById], references: [id])

  incidents Incident[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([systemId])
  @@index([errorCode])
  @@index([title])
  @@index([jobId])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  actionType String
  entityType String
  entityId   String
  details    String?
  ipAddress  String?
  userAgent  String?
  result     String   @default("SUCCESS")
  timestamp  DateTime @default(now())

  @@index([userId])
  @@index([actionType])
  @@index([entityType])
  @@index([timestamp])
  @@index([entityId])
}

enum PlanningPeriod {
  monthly
  quarterly
  annual
}

enum PlanningStatus {
  pending
  running
  done
}

enum InstanceStatus {
  active
  archived
}

model PlanningInstance {
  id          String         @id @default(uuid())
  name        String
  description String?
  period      PlanningPeriod
  startDate   DateTime
  endDate     DateTime
  status      InstanceStatus @default(active)
  createdById String
  createdBy   User           @relation("CreatedInstances", fields: [createdById], references: [id])
  jobs        PlanningJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([period, status])
  @@index([createdById])
}

model PlanningJob {
  id            String           @id @default(uuid())
  instanceId    String
  instance      PlanningInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  systemId      String
  system        System           @relation(fields: [systemId], references: [id])
  jobId         String
  job           Job              @relation(fields: [jobId], references: [id])
  scheduledTime DateTime
  dependencies  Json             @default("[]") // Array of PlanningJob IDs
  status        PlanningStatus   @default(pending)
  positionX     Float?
  positionY     Float?
  completedAt   DateTime?
  completedById String?
  completedBy   User?            @relation("CompletedPlanningJobs", fields: [completedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([instanceId, jobId])
  @@index([instanceId])
  @@index([systemId])
  @@index([status])
  @@index([jobId])
}

// ── Phase 2: Escalation Rules ──
model EscalationRule {
  id          String   @id @default(uuid())
  name        String
  systemId    String?
  system      System?  @relation(fields: [systemId], references: [id], onDelete: SetNull)
  severity    String?  // null = applies to all severities
  level       Int      @default(1) // escalation tier
  teamId      String
  team        Team     @relation("EscalationTeam", fields: [teamId], references: [id])
  delayMinutes Int     // minutes after SLA breach before this level triggers
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([systemId, severity, level])
  @@index([systemId, severity])
}

// ── Phase 2: Auto-Assignment Rules ──
model AutoAssignmentRule {
  id        String   @id @default(uuid())
  name      String
  systemId  String?
  system    System?  @relation(fields: [systemId], references: [id], onDelete: SetNull)
  severity  String?  // null = wildcard
  teamId    String
  team      Team     @relation("AutoAssignTeam", fields: [teamId], references: [id])
  priority  Int      @default(0) // higher wins
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([systemId, severity])
}

// ── Phase 2: Webhooks ──
model Webhook {
  id         String   @id @default(uuid())
  name       String
  url        String
  secret     String   // HMAC-SHA256 signing secret
  events     String   // comma-separated: incident.created,incident.resolved,...
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  deliveries WebhookDelivery[]
}

model WebhookDelivery {
  id            String   @id @default(uuid())
  webhookId     String
  webhook       Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event         String
  payload       String   @db.Text
  statusCode    Int?
  response      String?  @db.Text
  deliveredAt   DateTime?
  attemptCount  Int      @default(0)
  success       Boolean  @default(false)
  error         String?
  createdAt     DateTime @default(now())

  @@index([webhookId])
  @@index([event])
}

// ── Phase 2: Refresh Tokens ──
model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// ── In-App Notifications ──
model Notification {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String   // 'incident_created' | 'status_changed' | 'note_added' | 'file_uploaded'
  title      String
  message    String
  incidentId String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}
