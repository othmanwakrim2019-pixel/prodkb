# ═══════════════════════════════════════════════════════════════
# ProdKB — Production Environment Reference
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env on your server and fill in the values.
# You NEVER need to rebuild Docker images just to change these.
# After changing any value, run: docker compose up -d --force-recreate
# ═══════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────
POSTGRES_USER=prodkb
POSTGRES_PASSWORD=your_strong_db_password_here
POSTGRES_DB=prodkb

# ── Security (REQUIRED — must be long random strings) ─────────
JWT_SECRET=change_me_to_a_very_long_random_string_at_least_64_chars

# SECURITY_MODE — choose one:
#
# ── If you use an IP address (no domain, no SSL): ─────────────
# SECURITY_MODE=
# FRONTEND_URL=http://16.171.224.220:8080
# CORS_ORIGINS=http://16.171.224.220:8080
#
# ── If you have a domain + SSL (HTTPS via Certbot/Let's Encrypt):
# SECURITY_MODE=strict
# FRONTEND_URL=https://prodkb.yourdomain.com
# CORS_ORIGINS=https://prodkb.yourdomain.com
# (Also update Frontend nginx.conf to listen on 443 with SSL certs)
#
# ⚠ With strict: cookies require HTTPS — login BREAKS over plain HTTP
# ⚠ Only switch to strict AFTER SSL is fully working
SECURITY_MODE=

# ── App Public URL ────────────────────────────────────────────
# Replace with your server IP or domain name.
# Used for CORS validation and redirect URLs.
FRONTEND_URL=http://YOUR_SERVER_IP:8080
CORS_ORIGINS=http://YOUR_SERVER_IP:8080

# ── Frontend API URL (leave EMPTY for nginx proxy setup) ──────
# When empty, the frontend uses relative URLs (/api/v1/...) and
# nginx routes them to the backend — works for any IP or domain.
# Only set this if you are bypassing nginx entirely.
VITE_API_URL=

# ── Logging ───────────────────────────────────────────────────
# Options: error | warn | info | debug
LOG_LEVEL=info
NODE_ENV=production

# ── Database Seeding ──────────────────────────────────────────
# Set to true ONLY on first deployment to create the admin user.
# Leave false in normal production (prevents re-seeding on restart).
SEED=false

# ── Email / SMTP (optional — for incident notifications) ──────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourdomain.com

# ── File Storage (MinIO S3-compatible) ────────────────────────
# Change these from defaults before going to production!
S3_ACCESS_KEY_ID=change_me_minio_access_key
S3_SECRET_ACCESS_KEY=change_me_to_a_strong_minio_secret
S3_BUCKET=prodkb-uploads
S3_REGION=us-east-1
