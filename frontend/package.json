{
    "name": "prodkb-frontend",
    "private": true,
    "version": "1.0.0",
    "description": "ProdKB — Incident Management Frontend",
    "type": "module",
    "scripts": {
        "── Development ──": "",
        "dev": "vite",
        "preview": "vite preview",
        "start": "vite preview --host 0.0.0.0 --port ${PORT:-3000}",
        "build": "tsc -b && vite build",
        "── Testing ──": "",
        "test": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vitest run",
        "test:changed": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vitest run --changed",
        "test:watch": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vitest",
        "test:e2e": "playwright test",
        "── Code Quality ──": "",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"src/**/*.{ts,tsx}\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
        "── Code Generation ──": "",
        "api:types": "openapi-typescript ../backend/src/config/openapi.yaml -o src/types/api.generated.d.ts"
    },
    "dependencies": {
        "@types/dagre": "^0.7.53",
        "@xyflow/react": "^12.10.0",
        "axios": "^1.7.0",
        "clsx": "^2.1.1",
        "dagre": "^0.8.5",
        "date-fns": "^3.6.0",
        "dompurify": "^3.3.1",
        "i18next": "^25.8.11",
        "i18next-browser-languagedetector": "^8.2.1",
        "lucide-react": "^0.378.0",
        "papaparse": "^5.5.3",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-hook-form": "^7.51.0",
        "react-i18next": "^16.5.4",
        "react-router-dom": "^6.23.0",
        "recharts": "^3.7.0",
        "socket.io-client": "^4.8.3",
        "tailwind-merge": "^2.3.0"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/dompurify": "^3.0.5",
        "@types/node": "^25.2.2",
        "@types/papaparse": "^5.5.2",
        "@types/react": "^18.2.66",
        "@types/react-dom": "^18.2.22",
        "@typescript-eslint/eslint-plugin": "^7.2.0",
        "@typescript-eslint/parser": "^7.2.0",
        "@vitejs/plugin-react": "^4.2.1",
        "autoprefixer": "^10.4.19",
        "cross-env": "^10.1.0",
        "eslint": "^8.57.0",
        "eslint-plugin-react-hooks": "^4.6.0",
        "eslint-plugin-react-refresh": "^0.4.6",
        "happy-dom": "^20.5.3",
        "jsdom": "^27.0.1",
        "openapi-typescript": "^6.7.6",
        "postcss": "^8.4.38",
        "tailwindcss": "^3.4.3",
        "typescript": "^5.2.2",
        "vite": "^5.2.0",
        "vitest": "^2.1.9"
    }
}
